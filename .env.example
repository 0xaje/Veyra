# Never commit real credentials.
TATUM_API_KEY=
TATUM_CHAIN=
TATUM_NETWORK=
WALRUS_NETWORK=mainnet
# Populate after verifying official Walrus SDK/provider configuration.
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=

# Walrus Memory
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=veyra-dev

# Sui Proto Definitions
SUI_PROTO_DIR=

# Optional private payer/recipient relationships. No Walrus publication.
# Local-only example; keep SQLite and WAL/SHM files private and out of git.
# VEYRA_RELATIONSHIP_DB=/absolute/private/persistent/path/relationships.sqlite
# Hosted activation additionally requires an actually reviewed persistent store:
# VEYRA_ENABLE_PRIVATE_RELATIONSHIPS=true
# VEYRA_RELATIONSHIP_STORAGE_REVIEWED=true
# VEYRA_PUBLIC_ORIGIN=https://your-reviewed-origin.example
